[Unit]
Description=JST meeting minutes (gunicorn, served by nginx at /jst-meeting/)
Wants=network-online.target
After=network-online.target jst-wb2api.service

[Service]
Type=simple
User=jst-meeting
Group=jst-meeting
WorkingDirectory=/opt/jst-meeting/app
EnvironmentFile=/etc/jst-meeting/meeting.env
ExecStart=/opt/jst-meeting/venv/bin/gunicorn --workers 1 --worker-class gthread --threads 16 --bind 127.0.0.1:18899 --timeout 120 --no-control-socket src.app:app
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
# 会议助手和小助理每次运行会起一个 node 子进程（沙箱里的 pi），一起算在这个上限里
MemoryHigh=900M
MemoryMax=1100M
TasksMax=200
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
# 不设 ProtectKernelTunables：它会在 /proc 上叠只读挂载，沙箱（bubblewrap）就挂不了新的 /proc，
# 只能退回「能看到宿主 /proc」的弱模式，那样沙箱里能读到本服务的环境变量（密钥）。服务本身无特权，改不了内核参数。
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/jst-meeting
RestrictSUIDSGID=yes
RestrictRealtime=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
