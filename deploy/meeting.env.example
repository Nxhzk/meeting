# 捷士通智能会议：生产环境变量模板。
# 复制为 /etc/jst-meeting/meeting.env（权限 0640，属主 root:jst-meeting），再填写下面标记【必填】的值。
# systemd 的 EnvironmentFile 不展开变量；含双引号的值要用单引号包住。

# --- 数据位置 ---
UPLOAD_FOLDER=/var/lib/jst-meeting/uploads
CONFIG_DIR=/var/lib/jst-meeting/config
SQLALCHEMY_DATABASE_URI=sqlite:////var/lib/jst-meeting/instance/transcriptions.db
SECRET_KEY_FILE=/var/lib/jst-meeting/config/secret.key
TMPDIR=/var/lib/jst-meeting/tmp
TZ=Asia/Shanghai
PYTHONUTF8=1
PYTHONDONTWRITEBYTECODE=1
LOG_LEVEL=INFO

# --- 站点路径：nginx 把 /jst-meeting/ 转发给本机的 gunicorn ---
APP_BASE_URL=https://jstai.com.cn/jst-meeting
TRUSTED_PROXY_HOPS=1
TRUSTED_PROXIES=127.0.0.1
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_NAME=jst_meeting_session
SESSION_COOKIE_PATH=/jst-meeting/
REMEMBER_COOKIE_NAME=jst_meeting_remember
REMEMBER_COOKIE_PATH=/jst-meeting/

# --- 功能开关：只保留录音、转写、摘要 ---
ALLOW_REGISTRATION=false
ENABLE_PUBLIC_SHARING=false
ENABLE_INTERNAL_SHARING=false
ENABLE_AUTO_PROCESSING=false
ENABLE_AUTO_EXPORT=false
ENABLE_INQUIRE_MODE=false
ENABLE_INQUIRE=false
DEFAULT_UI_LANGUAGE=zh
DEFAULT_OUTPUT_LANGUAGE=Chinese
DEFAULT_TRANSCRIPTION_LANGUAGE=auto
DEFAULT_AUTO_SUMMARIZATION=true
DEFAULT_AUTO_SPEAKER_LABELLING=false
DEFAULT_EXTRACT_EVENTS=false
DISABLE_VOICE_EMBEDDING_CHECK=true
JOB_QUEUE_WORKERS=1
SUMMARY_QUEUE_WORKERS=1
CONVERT_QUEUE_WORKERS=1
INDEX_QUEUE_WORKERS=0

# --- 音频转文字：阿里云百炼 Fun-ASR 录音文件识别（自带说话人分离）---
TRANSCRIPTION_CONNECTOR=aliyun_asr
ALIYUN_ASR_MODEL=fun-asr
ASR_DIARIZE=true
# 【必填】百炼 API Key；缺少时应用照常保存录音，转写会提示"未配置"
ALIYUN_ASR_API_KEY=
# 录音先放到 COS，再把预签名链接交给阿里云识别（桶里的对象识别完即删）
S3_BUCKET_NAME=
S3_REGION=ap-beijing
S3_ENDPOINT_URL=https://cos.ap-beijing.myqcloud.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_PATH_STYLE=false

# --- 摘要模型：本机 WorkBuddy2API 网关，deepseek-v4.1-flash，思考档位 max ---
TEXT_MODEL_BASE_URL=http://127.0.0.1:7864/v1
# 【必填】网关的模型密钥，来自 /etc/jst-wb2api/model.key
TEXT_MODEL_API_KEY=
TEXT_MODEL_NAME=cn:deepseek-v4.1-flash
TEXT_MODEL_EXTRA_BODY='{"thinking":{"type":"enabled"},"reasoning_effort":"max"}'
# 模型上下文 1,000,000 tokens、最大输出 393,216 tokens：不设 SUMMARY_MAX_TOKENS 等就默认取最大值。
# 思考档位 max 的长会议可能要几分钟才返回，请求超时放宽到 30 分钟。
LLM_REQUEST_TIMEOUT=1800

# --- 会议助手（摘要由 pi agent 在 srt 沙箱里生成，见 docs/adr/0001） ---
# 模型默认沿用上面的 TEXT_MODEL_*；要单独指定时填 ASSISTANT_MODEL_BASE_URL / _API_KEY / _NAME。
# 思考档位：off / high / xhigh（xhigh 对应 deepseek 的 max）。
ASSISTANT_THINKING=xhigh
# 单次输出上限（含思考），默认 131072。
ASSISTANT_MAX_TOKENS=131072
# 一次生成最长运行时间（秒），超时即停止并保留原摘要。
ASSISTANT_TIMEOUT_SECONDS=900
# 沙箱：srt（默认，Linux 需要 bubblewrap、socat、ripgrep）或 off（仅限开发机）。
ASSISTANT_SANDBOX=srt
# Node.js（≥20.19）的路径；不填就用 PATH 里的 node。
# ASSISTANT_NODE=/usr/bin/node
ASSISTANT_NODE=/opt/jst-meeting/node/bin/node
# 沙箱的临时工作目录。不能放在 /var/lib/jst-meeting 下面（沙箱规定那里一律不可访问，工作目录会变成只读）：
# 用服务自己的私有 /tmp（systemd PrivateTmp）。
ASSISTANT_WORK_ROOT=/tmp
# 用 systemd-run 给每次运行限制内存和 CPU（内存上限 ASSISTANT_MEMORY_MB，CPU 半个核）。
ASSISTANT_SYSTEMD_RUN=false
ASSISTANT_MEMORY_MB=512

# --- 小助理 ---
# 小助理调用的本机内部接口（gunicorn 的监听地址，不经过 nginx）。
ASSISTANT_INTERNAL_URL=http://127.0.0.1:18899
# WorkBuddy 积分的只读通道（nginx 只放行面板 overview，管理密钥在 /etc/jst-wb2api/nginx-overview-auth.conf）。
# 用模型密钥 ASSISTANT_MODEL_API_KEY / TEXT_MODEL_API_KEY 访问。不填就不显示积分。
ASSISTANT_CREDITS_URL=https://jstai.com.cn/<模型接口的随机路径>/panel/overview
# 用户没设时区时，提醒和今日简报按这个时区算。
COMPANION_DEFAULT_TZ=Asia/Shanghai
# 小助理事件流（SSE）每条占 gunicorn 一个线程：总数要明显小于 --threads（16），超出时关掉最早的
COMPANION_MAX_STREAMS=8
COMPANION_MAX_STREAMS_PER_USER=3
# 长期记忆：每次放进上下文的字数预算；超过下面的字数或条数时后台自动整理（每人每天最多一次）
MEMORY_CONTEXT_CHARS=6000
MEMORY_CONSOLIDATE_CHARS=12000
MEMORY_CONSOLIDATE_ENTRIES=80
